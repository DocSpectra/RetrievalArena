{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "anchor": {
                "minLength": 1,
                "type": "string"
              },
              "arm_id": {
                "minLength": 1,
                "type": "string"
              },
              "basis": {
                "enum": [
                  "explicit_in_source",
                  "supported_inference",
                  "unsupported"
                ]
              },
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "confidence_status": {
                "const": "uncalibrated"
              },
              "coordinate_convention": {
                "const": "zero-based half-open UTF-8 bytes of exact raw file"
              },
              "corpus_id": {
                "minLength": 1,
                "type": "string"
              },
              "expected_reading_use": {
                "minLength": 1,
                "type": "string"
              },
              "href": {
                "minLength": 1,
                "type": "string"
              },
              "proposal_id": {
                "minLength": 1,
                "type": "string"
              },
              "provenance": {
                "additionalProperties": false,
                "properties": {
                  "attempt_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "model": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "prompt_version": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "provider": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "response_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "retry_of": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "schema_version": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "source_access": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "status": {
                    "enum": [
                      "mock-model",
                      "model-response"
                    ]
                  },
                  "timestamp": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "provider",
                  "model",
                  "prompt_version",
                  "schema_version",
                  "attempt_id",
                  "timestamp",
                  "response_sha256",
                  "source_access",
                  "retry_of",
                  "status"
                ],
                "type": "object"
              },
              "region_id": {
                "minLength": 1,
                "type": "string"
              },
              "relation": {
                "enum": [
                  "source_requires_target",
                  "source_continues_to_target",
                  "target_elaborates_source",
                  "target_exemplifies_source",
                  "target_diagnoses_source",
                  "related_context",
                  "insufficient_evidence"
                ]
              },
              "run_id": {
                "minLength": 1,
                "type": "string"
              },
              "schema_version": {
                "const": "retrieval_arena.embedded_links.v1.proposal"
              },
              "sentence": {
                "minLength": 1,
                "type": "string"
              },
              "snapshot_id": {
                "minLength": 1,
                "type": "string"
              },
              "source_id": {
                "minLength": 1,
                "type": "string"
              },
              "source_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_span": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "stated_intent": {
                "minLength": 1,
                "type": "string"
              },
              "target_evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "quote": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "span": {
                      "items": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    }
                  },
                  "required": [
                    "span",
                    "quote"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "target_fragment": {
                "type": "string"
              },
              "target_id": {
                "minLength": 1,
                "type": "string"
              },
              "target_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "schema_version",
              "proposal_id",
              "run_id",
              "arm_id",
              "region_id",
              "corpus_id",
              "snapshot_id",
              "source_id",
              "target_id",
              "source_sha256",
              "target_sha256",
              "href",
              "target_fragment",
              "coordinate_convention",
              "source_span",
              "anchor",
              "sentence",
              "target_evidence",
              "relation",
              "stated_intent",
              "expected_reading_use",
              "basis",
              "confidence",
              "confidence_status",
              "provenance"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "schema_validated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "proposal_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "proposal_sha256"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "structurally_validated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "validation_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "eligible",
              "reason",
              "validation_sha256"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "blinded_input_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "decision": {
                "enum": [
                  "eligible",
                  "reject",
                  "uncertain"
                ]
              },
              "evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "quote": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "span": {
                      "items": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    }
                  },
                  "required": [
                    "span",
                    "quote"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "response_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "reviewer_model": {
                "minLength": 1,
                "type": "string"
              },
              "reviewer_provider": {
                "minLength": 1,
                "type": "string"
              },
              "rubric_version": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "enum": [
                  "mock-model",
                  "model-response"
                ]
              },
              "uncertainty": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reviewer_provider",
              "reviewer_model",
              "rubric_version",
              "decision",
              "evidence",
              "uncertainty",
              "response_sha256",
              "blinded_input_sha256",
              "status"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "eligible"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "semantic": {
                "const": true
              },
              "structural": {
                "const": true
              }
            },
            "required": [
              "structural",
              "semantic"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "selected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "achieved_budget": {
                "minimum": 0,
                "type": "integer"
              },
              "conflicts_skips": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "objective_input_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "objective_output_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "rank": {
                "minimum": 1,
                "type": "integer"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "requested_budget": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "rank",
              "reason",
              "objective_input_sha256",
              "objective_output_sha256",
              "requested_budget",
              "achieved_budget",
              "conflicts_skips"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "edge_id": {
                "minLength": 1,
                "type": "string"
              },
              "facts_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "occurrence_id": {
                "minLength": 1,
                "type": "string"
              },
              "patch_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_after_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_before_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "facts_sha256",
              "patch_sha256",
              "source_before_sha256",
              "source_after_sha256",
              "occurrence_id",
              "edge_id"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "after_graph_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "before_graph_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "facts_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "rendered_after_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "rendered_before_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "facts_sha256",
              "rendered_before_sha256",
              "rendered_after_sha256",
              "before_graph_sha256",
              "after_graph_sha256"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "no_new_edge": {
                "type": "boolean"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "no_new_edge"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reverted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "restored_source_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "reason",
              "restored_source_sha256"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "arm_id": {
      "minLength": 1,
      "type": "string"
    },
    "authority": {
      "enum": [
        "model",
        "reviewer",
        "host"
      ]
    },
    "event_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "payload": {},
    "previous_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "region_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "retrieval_arena.embedded_links.v1.event"
    },
    "supersedes_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "proposed",
        "schema_validated",
        "structurally_validated",
        "reviewed",
        "eligible",
        "selected",
        "applied",
        "verified",
        "rejected",
        "failed",
        "reverted"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "previous_sha256",
    "proposal_id",
    "run_id",
    "arm_id",
    "region_id",
    "type",
    "authority",
    "timestamp",
    "supersedes_event_id",
    "payload"
  ],
  "type": "object"
}
