ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
ARG SOURCE_TREE
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" io.retrieval-arena.source.tree="${SOURCE_TREE}"
ENV RA_SOURCE_COMMIT=${SOURCE_COMMIT} RA_SOURCE_TREE=${SOURCE_TREE} PYTHONPATH=/app HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
COPY retrieval_arena /app/retrieval_arena
COPY tests/rag_semantic_graph_rerank/runner.py /app/runner.py
WORKDIR /app
ENTRYPOINT ["python", "-B", "-m", "retrieval_arena.graph.support_access_rank"]
